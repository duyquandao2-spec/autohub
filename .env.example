# News provider: newsapi | gnews | rss
NEWS_PROVIDER=newsapi

# API keys (configure only the active provider). Do NOT commit real keys.
NEWS_API_KEY=replace_with_newsapi_key
GNEWS_API_KEY=replace_with_gnews_key

# Cache / resilience
NEWS_CACHE_TTL_SECONDS=1200
NEWS_FETCH_TIMEOUT_MS=8000
NEWS_MAX_RESULTS=6
NEWS_PUBLIC_LIMIT=3

# Allowed domains and RSS feeds (comma-separated)
NEWS_ALLOWED_DOMAINS=acea.auto,reuters.com,caranddriver.com,roadandtrack.com,automotivenews.com
NEWS_RSS_FEEDS=https://example.com/official-automotive-feed.xml

# Admin refresh secret (development/admin only; never expose via VITE_ prefix)
NEWS_ADMIN_REFRESH_SECRET=replace_with_strong_random_value
