# News provider: newsapi | gnews | rss | hybrid_rss
NEWS_PROVIDER=hybrid_rss

# Hybrid RSS/Feed sources (comma-separated)
# autodaily.vn/feed and cartimes /rss/xe-va-doi-song.rss are 404 upstream;
# the URLs below are the verified working feeds for the same sources.
NEWS_RSS_FEEDS=https://forum.autodaily.vn/forums/tin-tuc/index.rss,https://forum.autodaily.vn/forums/xe-xanh/index.rss,https://cartimes.tapchicongthuong.vn/rss/home.rss,https://www.caranddriver.com/rss/all.xml

# API keys (configure only the active provider). Do NOT commit real keys.
NEWS_API_KEY=replace_with_newsapi_key
GNEWS_API_KEY=replace_with_gnews_key

# Cache / resilience — 21600 (6h) or 43200 (12h) for daily auto-refresh
NEWS_CACHE_TTL_SECONDS=21600
NEWS_FETCH_TIMEOUT_MS=8000
NEWS_MAX_RESULTS=6
NEWS_PUBLIC_LIMIT=3

# Allowed domains and RSS feeds (comma-separated)
NEWS_ALLOWED_DOMAINS=autodaily.vn,cartimes.tapchicongthuong.vn,tapchicongthuong.vn,caranddriver.com

# Admin refresh secret (development/admin only; never expose via VITE_ prefix)
NEWS_ADMIN_REFRESH_SECRET=replace_with_strong_random_value
