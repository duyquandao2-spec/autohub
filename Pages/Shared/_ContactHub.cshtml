@* ── AUTOHUB Floating Contact Hub — UI only, placeholder actions, independent overlay ── *@
<div class="contact-hub" data-contact-hub>
    <ul class="contact-hub__menu" id="contactHubMenu" aria-label="Kênh liên hệ APEX">
        <li class="contact-hub__row" style="--i:0">
            <button class="contact-hub__item" type="button" data-channel="phone" aria-label="Gọi tư vấn" style="--ch-bg:#2b57a5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span class="contact-hub__tooltip">Gọi tư vấn</span>
            </button>
        </li>
        <li class="contact-hub__row" style="--i:1">
            <button class="contact-hub__item" type="button" data-channel="chatbot" aria-label="M&#7903; tr&#7907; l&#253; APEX" style="--ch-bg:#4285e8">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                <span class="contact-hub__tooltip">Chatbot</span>
            </button>
        </li>
        <li class="contact-hub__row" style="--i:2">
            <button class="contact-hub__item contact-hub__item--light" type="button" data-channel="email" aria-label="Email" style="--ch-bg:#f5f7f7;--ch-fg:#101315">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <span class="contact-hub__tooltip">Email</span>
            </button>
        </li>
        <li class="contact-hub__row" style="--i:3">
            <button class="contact-hub__item" type="button" data-channel="facebook" aria-label="Facebook" style="--ch-bg:#2469cc">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                <span class="contact-hub__tooltip">Facebook</span>
            </button>
        </li>
        <li class="contact-hub__row" style="--i:4">
            <button class="contact-hub__item" type="button" data-channel="youtube" aria-label="YouTube" style="--ch-bg:#c93630">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
                <span class="contact-hub__tooltip">YouTube</span>
            </button>
        </li>
        <li class="contact-hub__row" style="--i:5">
            <button class="contact-hub__item" type="button" data-channel="zalo" aria-label="Zalo" style="--ch-bg:#1489cb">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
                <span class="contact-hub__tooltip">Zalo</span>
            </button>
        </li>
    </ul>
    <button class="contact-hub__toggle" type="button" data-contact-hub-toggle aria-expanded="false" aria-controls="contactHubMenu" aria-haspopup="true" aria-label="Mở menu liên hệ">
        <img src="~/Images/apex-logo.png" alt="" width="32" height="32" />
        <span class="contact-hub__dot" aria-hidden="true"></span>
    </button>
</div>
