@page
@model AutoHub.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__mark">AUTOHUB · APEX</div>
        <h1>Quên mật khẩu</h1>
        <p class="auth-card__lede">Nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu.</p>

        @if (Model.Sent)
        {
            <div class="auth-status">Nếu email tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn đặt lại mật khẩu. Liên hệ hỗ trợ nếu bạn cần trợ giúp thêm.</div>
        }

        <form method="post" asp-page="/auth/forgotpassword">
            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="username" required />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn-auth btn-auth--block">Gửi yêu cầu</button>
        </form>

        <div class="auth-page__alt">
            Nhớ mật khẩu? <a href="/login">Đăng nhập</a>
        </div>
    </div>
</div>
