@page
@model AutoHub.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__mark">AUTOHUB · APEX</div>
        <h1>Đặt lại mật khẩu</h1>
        <p class="auth-card__lede">Nhập mật khẩu mới cho tài khoản của bạn.</p>

        <form method="post" asp-page="/auth/resetpassword" asp-route-email="@Model.Email" asp-route-token="@Model.Token">
            <div class="field">
                <label asp-for="NewPassword">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
                <div class="auth-pwmeta">Tối thiểu 6 ký tự, có ít nhất một chữ số.</div>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn-auth btn-auth--block">Đặt lại mật khẩu</button>
        </form>
    </div>
</div>
