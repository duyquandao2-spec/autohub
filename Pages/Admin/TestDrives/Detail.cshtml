@page
@model AutoHub.Pages.Admin.TestDrives.DetailModel
@{
    ViewData["Title"] = "Chi tiết lịch lái thử";
    ViewData["AdminBreadcrumb"] = $"Lịch lái thử #{Model.Booking!.BookingId}";
    var b = Model.Booking;
}
@if (TempData["Ok"] != null)
{
    <div class="apx-alert">@TempData["Ok"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="apx-alert apx-alert--danger">@TempData["Err"]</div>
}

<div class="apx-bar">
    <a class="apx-btn apx-btn--ghost" asp-page="/admin/testdrives/index">← Danh sách</a>
    <span class="badge badge--@AutoHub.Services.StatusWorkflow.BadgeClass(b.Status)">@AutoHub.Services.StatusWorkflow.Label(b.Status)</span>
</div>

<div class="apx-detail">
    <div class="admin-grid" style="grid-template-columns:minmax(0,1fr);gap:18px">
        <div class="apx-panel">
            <div class="apx-panel__head"><h2>Thông tin lịch lái thử</h2></div>
            <div class="apx-kv" style="padding:18px 20px">
                <div class="apx-kv__item"><dt>Họ tên</dt><dd>@b.FullName</dd></div>
                <div class="apx-kv__item"><dt>Điện thoại</dt><dd>@b.Phone</dd></div>
                <div class="apx-kv__item"><dt>Email</dt><dd>@(b.Email ?? "—")</dd></div>
                <div class="apx-kv__item"><dt>Xe</dt><dd>@(b.Variant?.VariantName ?? "—")</dd></div>
                <div class="apx-kv__item"><dt>Ngày</dt><dd>@b.PreferredDate.ToString("dd/MM/yyyy")</dd></div>
                <div class="apx-kv__item"><dt>Khung giờ</dt><dd>@b.TimeSlot</dd></div>
                <div class="apx-kv__item"><dt>Showroom</dt><dd>@(b.Showroom?.Name ?? "—")</dd></div>
                <div class="apx-kv__item"><dt>Ngày đặt</dt><dd>@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div class="apx-kv__item" style="grid-column:1/-1"><dt>Ghi chú</dt><dd>@(b.Notes ?? "—")</dd></div>
            </div>
        </div>

        <div class="apx-panel">
            <div class="apx-panel__head"><h2>Cập nhật</h2></div>
            <div style="padding:18px 20px">
                <form method="post" asp-page-handler="Update">
                    <input type="hidden" name="id" value="@b.BookingId" />
                    <div class="field" style="margin-bottom:12px">
                        <label>Trạng thái</label>
                        @if (!Model.IsTerminal)
                        {
                            <select class="apx-select" name="status" style="width:100%">
                                @foreach (var s in Model.StatusOptions)
                                {
                                    <option value="@s" selected="@(b.Status == s)">@AutoHub.Services.StatusWorkflow.Label(s)@(s == b.Status ? " (hiện tại)" : "")</option>
                                }
                            </select>
                            <span class="muted" style="font-size:.72rem">Quy trình: Chờ duyệt → Đã xác nhận → Đã hoàn thành · (Chờ duyệt/Đã xác nhận → Đã hủy)</span>
                        }
                        else
                        {
                            <input type="hidden" name="status" value="@b.Status" />
                            <p class="text-m">Trạng thái cuối: <strong>@AutoHub.Services.StatusWorkflow.Label(b.Status)</strong> — không thể thay đổi.</p>
                        }
                    </div>
                    <div class="field" style="margin-bottom:12px">
                        <label>Showroom</label>
                        <select class="apx-select" name="showroomId" style="width:100%">
                            <option value="">— Chưa chọn —</option>
                            @foreach (var s in Model.Showrooms)
                            {
                                <option value="@s.Id" selected="@(b.ShowroomId == s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field" style="margin-bottom:14px">
                        <label>Phân công nhân viên</label>
                        <select class="apx-select" name="assignedStaffId" style="width:100%">
                            <option value="">— Chưa phân công —</option>
                            @foreach (var st in Model.Staff)
                            {
                                <option value="@st.Id" selected="@(b.AssignedStaffId == st.Id)">@st.FullName (@st.Email)</option>
                            }
                        </select>
                    </div>
                    <button class="apx-btn" type="submit">Lưu thay đổi</button>
                </form>
            </div>
        </div>
    </div>
</div>
